# syntax=docker/dockerfile:1.7
ARG USERNAME=illumination-k
# Pin base image by digest for reproducibility.
ARG NIX_IMAGE=nixos/nix:2.34.6@sha256:e2fe74e96e965653c7b8f16ac64d1e56581c63c84d7fa07fb0692fd055cd06b0

########################################
# Stage 1: Nix base (pinned multi-user nix image)
########################################
FROM ${NIX_IMAGE} AS nix-base
ARG USERNAME

RUN mkdir -p /etc/nix && \
    printf '%s\n' \
      'experimental-features = nix-command flakes' \
      'max-jobs = auto' \
      'cores = 0' \
      > /etc/nix/nix.conf

RUN mkdir -p /home/${USERNAME}

ENV USER=${USERNAME} \
    HOME=/home/${USERNAME}

########################################
# Stage 2: Fetch flake inputs
########################################
FROM nix-base AS deps
ARG USERNAME
WORKDIR /workspace

COPY flake.nix flake.lock ./

RUN --mount=type=cache,target=/root/.cache/nix,sharing=locked \
    nix flake archive --json > /dev/null

########################################
# Stage 3: Build home-manager activation package
########################################
FROM deps AS builder
ARG USERNAME

COPY . .

RUN --mount=type=cache,target=/root/.cache/nix,sharing=locked \
    ARCH=$(uname -m) && \
    case "$ARCH" in \
      aarch64) SYSTEM="aarch64-linux" ;; \
      x86_64)  SYSTEM="x86_64-linux" ;; \
      *)       echo "Unsupported: $ARCH" && exit 1 ;; \
    esac && \
    nix build --impure --no-update-lock-file \
      -o /home/${USERNAME}/result \
      .#homeConfigurations."${USERNAME}@${SYSTEM}".activationPackage

# Drop build-time deps; keep only runtime closure referenced by result.
RUN nix-collect-garbage && nix-store --optimise

########################################
# Stage 4: Slim runtime image
########################################
FROM nix-base AS runtime
ARG USERNAME

COPY --from=builder /nix /nix
COPY --from=builder --chown=${USERNAME}:${USERNAME} /home/${USERNAME}/result /home/${USERNAME}/result

RUN mkdir -p /home/${USERNAME}/.local/state/nix/profiles \
             /home/${USERNAME}/.local/state/home-manager/gcroots && \
    /home/${USERNAME}/result/activate && \
    echo "=== Installed packages ===" && \
    ls /home/${USERNAME}/result/home-path/bin/ | sort

WORKDIR /home/${USERNAME}

########################################
# Stage 5: Interactive dev image (K8s dev pod)
#   - sshd常駐でZed Remote / ssh接続可能
#   - herdr/zellij + claude-code入り（home-manager経由）
########################################
FROM runtime AS dev
ARG USERNAME
ARG UID=1000
ARG GID=1000

# ログインユーザーとsshd特権分離ユーザーを作成
# （ベースイメージにshadowツールがない前提で/etc/passwdへ直接追記）
RUN set -eu; \
    grep -q "^${USERNAME}:" /etc/passwd || { \
      echo "${USERNAME}:x:${UID}:${GID}::/home/${USERNAME}:/home/${USERNAME}/result/home-path/bin/zsh" >> /etc/passwd; \
      echo "${USERNAME}:x:${GID}:" >> /etc/group; \
      echo "${USERNAME}:*:::::::" >> /etc/shadow; \
    }; \
    grep -q '^sshd:' /etc/passwd || { \
      echo 'sshd:x:499:499:sshd privsep:/var/empty:/sbin/nologin' >> /etc/passwd; \
      echo 'sshd:x:499:' >> /etc/group; \
    }; \
    mkdir -p /var/empty /etc/ssh /data/ssh /workspace; \
    chown -Rh ${UID}:${GID} /home/${USERNAME} /workspace

COPY docker/sshd_config /etc/ssh/sshd_config
COPY docker/entrypoint-dev.sh /usr/local/bin/entrypoint-dev.sh
RUN chmod 755 /usr/local/bin/entrypoint-dev.sh

ENV TERM=xterm-256color
EXPOSE 22
ENTRYPOINT ["/usr/local/bin/entrypoint-dev.sh"]
